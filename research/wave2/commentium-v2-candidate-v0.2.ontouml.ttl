_:occursInS a ontouml:Property ; ontouml:propertyType :Comment .
_:occursInT a ontouml:Property ; ontouml:propertyType :Situation ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "1..*" ; ontouml:lowerBound "1" ; ontouml:upperBound "*" ] .

