_:viaS a ontouml:Property ; ontouml:propertyType :Comment .
_:viaT a ontouml:Property ; ontouml:propertyType :Medium ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "1..*" ; ontouml:lowerBound "1" ; ontouml:upperBound "*" ] .

:rel_hasTime a ontouml:Relation ; ontouml:name "hasTime"@en ; ontouml:sourceEnd _:hasTimeS ; ontouml:targetEnd _:hasTimeT ; ontouml:relationEnd _:hasTimeS, _:hasTimeT .
_:hasTimeS a ontouml:Property ; ontouml:propertyType :Comment .
_:hasTimeT a ontouml:Property ; ontouml:propertyType :Time ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "1" ; ontouml:lowerBound "1" ; ontouml:upperBound "1" ] .

:rel_styleInheresIn a ontouml:Relation ; ontouml:name "styleInheresIn"@en ; ontouml:stereotype ontouml:characterization ; ontouml:sourceEnd _:styleS ; ontouml:targetEnd _:styleT ; ontouml:relationEnd _:styleS, _:styleT .
_:styleS a ontouml:Property ; ontouml:propertyType :ExpressionStyle .
_:styleT a ontouml:Property ; ontouml:propertyType :CommentMessage ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "1" ; ontouml:lowerBound "1" ; ontouml:upperBound "1" ] .

