_:refersT a ontouml:Property ; ontouml:propertyType :ReferencedEntity ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "0..*" ; ontouml:lowerBound "0" ; ontouml:upperBound "*" ] .

