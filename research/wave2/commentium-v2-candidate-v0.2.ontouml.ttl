@prefix : <https://w3id.org/commentium/model/v2#> .
@prefix ontouml: <https://w3id.org/ontouml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/commentium/model/v2/> a ontouml:Project ;
  ontouml:name "Commentium v2 Candidate Model v0.2"@en ;
  ontouml:model :Core .

:Core a ontouml:Package ; ontouml:name "Commentium Core"@en .

:Comment a ontouml:Class ; ontouml:name "Comment"@en ; ontouml:stereotype ontouml:event ; ontouml:restrictedTo ontouml:event ; ontouml:isDerived false .
:Response a ontouml:Class ; ontouml:name "Response"@en ; ontouml:stereotype ontouml:event ; ontouml:restrictedTo ontouml:event ; ontouml:isDerived false .
:CommentThread a ontouml:Class ; ontouml:name "CommentThread"@en ; ontouml:stereotype ontouml:event ; ontouml:restrictedTo ontouml:event ; ontouml:isDerived false .
:Commentable a ontouml:Class ; ontouml:name "Commentable"@en ; ontouml:stereotype ontouml:historicalRoleMixin ; ontouml:restrictedTo ontouml:functionalComplex ; ontouml:isDerived true .
:Agent a ontouml:Class ; ontouml:name "Agent"@en ; ontouml:stereotype ontouml:category ; ontouml:restrictedTo ontouml:functionalComplex ; ontouml:isDerived false .
:Commenter a ontouml:Class ; ontouml:name "Commenter"@en ; ontouml:stereotype ontouml:historicalRoleMixin ; ontouml:restrictedTo ontouml:functionalComplex ; ontouml:isDerived true .
:IntendedAudience a ontouml:Class ; ontouml:name "IntendedAudience"@en ; ontouml:stereotype ontouml:roleMixin ; ontouml:restrictedTo ontouml:functionalComplex ; ontouml:isDerived true .
:CommentSubject a ontouml:Class ; ontouml:name "CommentSubject"@en ; ontouml:stereotype ontouml:roleMixin ; ontouml:restrictedTo ontouml:functionalComplex ; ontouml:isDerived true .
:ReferencedEntity a ontouml:Class ; ontouml:name "ReferencedEntity"@en ; ontouml:stereotype ontouml:roleMixin ; ontouml:restrictedTo ontouml:functionalComplex ; ontouml:isDerived true .
:Interpretation a ontouml:Class ; ontouml:name "Interpretation"@en ; ontouml:stereotype ontouml:event ; ontouml:restrictedTo ontouml:event ; ontouml:isDerived false .
:InterpretedMeaning a ontouml:Class ; ontouml:name "InterpretedMeaning"@en ; ontouml:stereotype ontouml:kind ; ontouml:restrictedTo ontouml:functionalComplex ; rdfs:comment "Semantic nature: information object."@en .
:InterpretiveAssumption a ontouml:Class ; ontouml:name "InterpretiveAssumption"@en ; ontouml:stereotype ontouml:kind ; ontouml:restrictedTo ontouml:functionalComplex ; rdfs:comment "Semantic nature: information object."@en .
:AssertedRelation a ontouml:Class ; ontouml:name "AssertedRelation"@en ; ontouml:stereotype ontouml:kind ; ontouml:restrictedTo ontouml:functionalComplex ; rdfs:comment "Semantic nature: propositional information object."@en .
:AssertedRelationKind a ontouml:Class ; ontouml:name "AssertedRelationKind"@en ; ontouml:stereotype ontouml:enumeration ; ontouml:restrictedTo ontouml:abstract .
:InteractionNorm a ontouml:Class ; ontouml:name "InteractionNorm"@en ; ontouml:stereotype ontouml:kind ; ontouml:restrictedTo ontouml:functionalComplex ; rdfs:comment "Semantic nature: social object."@en .
:Situation a ontouml:Class ; ontouml:name "Situation"@en ; ontouml:stereotype ontouml:situation ; ontouml:restrictedTo ontouml:situation .
:Medium a ontouml:Class ; ontouml:name "Medium"@en ; ontouml:stereotype ontouml:category ; ontouml:restrictedTo ontouml:functionalComplex .
:CommentMessage a ontouml:Class ; ontouml:name "CommentMessage"@en ; ontouml:stereotype ontouml:kind ; ontouml:restrictedTo ontouml:functionalComplex ; rdfs:comment "Semantic nature: information object; representation-neutral and potentially multimodal."@en .
:Intent a ontouml:Class ; ontouml:name "Intent"@en ; ontouml:stereotype ontouml:mode ; ontouml:restrictedTo ontouml:intrinsicMode .
:Stance a ontouml:Class ; ontouml:name "Stance"@en ; ontouml:stereotype ontouml:mode ; ontouml:restrictedTo ontouml:intrinsicMode .
:ExpressionStyle a ontouml:Class ; ontouml:name "ExpressionStyle"@en ; ontouml:stereotype ontouml:quality ; ontouml:restrictedTo ontouml:quality .
:Time a ontouml:Class ; ontouml:name "Time"@en ; ontouml:stereotype ontouml:quality ; ontouml:restrictedTo ontouml:quality .

:gen_Response_Comment a ontouml:Generalization ; ontouml:specific :Response ; ontouml:general :Comment .
:gen_Commenter_Agent a ontouml:Generalization ; ontouml:specific :Commenter ; ontouml:general :Agent .

:ark_praises a ontouml:Literal ; ontouml:name "praises"@en .
:ark_criticizes a ontouml:Literal ; ontouml:name "criticizes"@en .
:ark_supports a ontouml:Literal ; ontouml:name "supports"@en .
:ark_disagreesWith a ontouml:Literal ; ontouml:name "disagreesWith"@en .
:ark_questions a ontouml:Literal ; ontouml:name "questions"@en .
:ark_clarifies a ontouml:Literal ; ontouml:name "clarifies"@en .
:ark_cites a ontouml:Literal ; ontouml:name "cites"@en .
:ark_mentions a ontouml:Literal ; ontouml:name "mentions"@en .
:ark_requests a ontouml:Literal ; ontouml:name "requests"@en .
:ark_reports a ontouml:Literal ; ontouml:name "reports"@en .
:AssertedRelationKind ontouml:literal :ark_praises, :ark_criticizes, :ark_supports, :ark_disagreesWith, :ark_questions, :ark_clarifies, :ark_cites, :ark_mentions, :ark_requests, :ark_reports .

# Relation helper pattern: target-end cardinality denotes number of targets allowed per source instance.

:rel_hasMessage a ontouml:Relation ; ontouml:name "hasMessage"@en ; ontouml:sourceEnd _:hasMessageS ; ontouml:targetEnd _:hasMessageT ; ontouml:relationEnd _:hasMessageS, _:hasMessageT .
_:hasMessageS a ontouml:Property ; ontouml:propertyType :Comment .
_:hasMessageT a ontouml:Property ; ontouml:propertyType :CommentMessage ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "1" ; ontouml:lowerBound "1" ; ontouml:upperBound "1" ] .

:rel_anchoredTo a ontouml:Relation ; ontouml:name "anchoredTo"@en ; ontouml:stereotype ontouml:participation ; ontouml:sourceEnd _:anchoredToS ; ontouml:targetEnd _:anchoredToT ; ontouml:relationEnd _:anchoredToS, _:anchoredToT .
_:anchoredToS a ontouml:Property ; ontouml:propertyType :Comment .
_:anchoredToT a ontouml:Property ; ontouml:propertyType :Commentable ; ontouml:cardinality [ a ontouml:Cardinality ; ontouml:cardinalityValue "1..*" ; ontouml:lowerBound "1" ; ontouml:upperBound "*" ] .

